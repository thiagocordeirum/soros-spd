% =============================================================================
%  relatorio.sty — formatação de relatórios acadêmicos
%  Uso:  \usepackage[codigo,tikz]{relatorio}
%
%  Opções:
%    codigo  — carrega o listings já configurado (blocos de código)
%    tikz    — carrega tikz + pgfplots (diagramas e gráficos)
%  Sem opções, nenhum dos dois é carregado (compilação mais rápida).
%
%  Este arquivo NÃO deve ser editado a cada trabalho: os dados do relatório
%  são definidos no arquivo principal (ver modelo.tex).
% =============================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{relatorio}[2026/08/31 v1.0 Template de relatorio academico]

% ── Opções ───────────────────────────────────────────────────────────────────
\newif\ifrel@codigo \rel@codigofalse
\newif\ifrel@tikz   \rel@tikzfalse
\DeclareOption{codigo}{\rel@codigotrue}
\DeclareOption{tikz}{\rel@tikztrue}
\DeclareOption*{\PackageWarning{relatorio}{Opcao desconhecida: \CurrentOption}}
\ProcessOptions\relax

% ── Idioma e codificação ─────────────────────────────────────────────────────
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage[brazilian]{babel}

% ── Cores ────────────────────────────────────────────────────────────────────
% xcolor é carregado UMA vez, já com [table] (que traz o colortbl junto).
% Carregar xcolor de novo com outra opção causa "Option clash for package".
\RequirePackage[table]{xcolor}

% ── Matemática, figuras e tabelas ────────────────────────────────────────────
\RequirePackage{amsmath,amssymb}
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{multirow}
\RequirePackage{mdframed}
\RequirePackage[font=small,labelfont=bf]{caption}
\graphicspath{{figuras/}{imagens/}{./}}

% ── Layout da página ─────────────────────────────────────────────────────────
% headheight/footskip definidos aqui evitam o aviso
% "Package fancyhdr Warning: \headheight is too small".
\RequirePackage[
  a4paper,
  top=2cm, bottom=2cm, left=3cm, right=3cm,
  headheight=26pt, headsep=12pt, footskip=26pt,
  includehead, includefoot
]{geometry}
\RequirePackage{setspace}
\RequirePackage{fancyhdr}
\RequirePackage{tocloft}

% ── Diagramas (opcional) ─────────────────────────────────────────────────────
\ifrel@tikz
  \RequirePackage{tikz}
  \RequirePackage{pgfplots}
  \pgfplotsset{compat=1.18}
  \usetikzlibrary{arrows.meta, positioning, shapes.geometric, fit,
                  backgrounds, calc, decorations.pathreplacing}
\fi

% ── Código-fonte (opcional) ──────────────────────────────────────────────────
\definecolor{codebg}{RGB}{245,245,245}
\definecolor{codeframe}{RGB}{200,200,200}
\definecolor{codecomment}{RGB}{100,100,100}
\definecolor{codekeyword}{RGB}{0,0,180}
\definecolor{codestring}{RGB}{160,0,0}
\definecolor{placeholderbg}{RGB}{230,240,255}
\definecolor{placeholderframe}{RGB}{100,140,200}

\ifrel@codigo
  \RequirePackage{listings}
  % PowerShell não vem de fábrica no listings
  \lstdefinelanguage{PowerShell}{
    keywords={param,function,if,else,elseif,foreach,while,return,
              New-Item,Start-Job,Start-Process,Start-Sleep,Stop-Process,
              Test-Path,Select-Object,Measure-Object,ForEach-Object,Write-Host},
    sensitive=false,
    morecomment=[l]{\#},
    morestring=[b]",
    morestring=[b]'
  }
  \lstset{
    backgroundcolor=\color{codebg},
    frame=single,
    rulecolor=\color{codeframe},
    basicstyle=\ttfamily\small,
    keywordstyle=\color{codekeyword}\bfseries,
    commentstyle=\color{codecomment}\itshape,
    stringstyle=\color{codestring},
    numbers=none,              % use numbers=left para numerar as linhas
    breaklines=true,
    breakatwhitespace=true,
    showstringspaces=false,
    columns=fullflexible,
    tabsize=2,
    language=bash,
    % permite acentos dentro dos blocos de código
    extendedchars=true,
    inputencoding=utf8,
    literate=%
      {á}{{\'a}}1 {é}{{\'e}}1 {í}{{\'i}}1 {ó}{{\'o}}1 {ú}{{\'u}}1
      {â}{{\^a}}1 {ê}{{\^e}}1 {ô}{{\^o}}1 {ã}{{\~a}}1 {õ}{{\~o}}1
      {ç}{{\c c}}1 {à}{{\`a}}1
      {Á}{{\'A}}1 {É}{{\'E}}1 {Í}{{\'I}}1 {Ó}{{\'O}}1 {Ú}{{\'U}}1
      {Â}{{\^A}}1 {Ê}{{\^E}}1 {Ô}{{\^O}}1 {Ã}{{\~A}}1 {Õ}{{\~O}}1
      {Ç}{{\c C}}1
  }
\fi

% ── Links (hyperref por último) ──────────────────────────────────────────────
\RequirePackage[
  colorlinks=true,
  citecolor=blue!40!black,
  linkcolor=black,
  urlcolor=blue!40!black
]{hyperref}

% =============================================================================
%  CAMPOS DO RELATÓRIO
%  Definidos no arquivo principal: \disciplina{Cálculo II}, \titulo{...}, etc.
% =============================================================================
\def\rel@instituicao{Universidade do Estado do Amazonas}
\def\rel@escola{Escola Superior de Tecnologia}
\def\rel@curso{Engenharia de Computação}
\def\rel@disciplina{}
\def\rel@professor{}
\def\rel@titulo{Título do Trabalho}
\def\rel@cabecalho{}
\def\rel@descricao{}
\def\rel@local{Manaus -- Amazonas}
\def\rel@data{\today}
\def\rel@autoreslinhas{}
\def\rel@autoresinline{}

\newcommand{\instituicao}[1]{\gdef\rel@instituicao{#1}}
\newcommand{\escola}[1]{\gdef\rel@escola{#1}}
\newcommand{\curso}[1]{\gdef\rel@curso{#1}}
\newcommand{\disciplina}[1]{\gdef\rel@disciplina{#1}}
\newcommand{\professor}[1]{\gdef\rel@professor{#1}}
\newcommand{\titulo}[1]{\gdef\rel@titulo{#1}}
\newcommand{\cabecalho}[1]{\gdef\rel@cabecalho{#1}}  % texto do topo das páginas
\newcommand{\descricao}[1]{\gdef\rel@descricao{#1}}  % parágrafo da folha de rosto
\newcommand{\local}[1]{\gdef\rel@local{#1}}
\newcommand{\data}[1]{\gdef\rel@data{#1}}

% \autor pode ser chamado quantas vezes forem necessárias
\newcommand{\autor}[1]{%
  \ifx\rel@autoreslinhas\@empty
    \gdef\rel@autoreslinhas{#1}%
    \gdef\rel@autoresinline{#1}%
  \else
    \g@addto@macro\rel@autoreslinhas{\\ #1}%
    \g@addto@macro\rel@autoresinline{; #1}%
  \fi
}

\AtBeginDocument{%
  \hypersetup{
    pdftitle={\rel@titulo},
    pdfauthor={\rel@autoresinline},
    pdfsubject={\rel@disciplina},
    bookmarksnumbered=true
  }%
}

% =============================================================================
%  ESTILO DO TEXTO
% =============================================================================
\setstretch{1.25}
\setlength{\parindent}{0pt}
\setlength{\parskip}{4pt}
% Para o padrão ABNT, use no arquivo principal (depois do \usepackage):
%   \setstretch{1.5}
%   \setlength{\parindent}{1.25cm}
%   \setlength{\parskip}{0pt}

\renewcommand{\cftsecleader}{\cftdotfill{\cftdotsep}}

% =============================================================================
%  CABEÇALHO E RODAPÉ
% =============================================================================
\fancypagestyle{relatorio}{%
  \fancyhf{}
  \renewcommand{\headrulewidth}{0.4pt}
  \renewcommand{\footrulewidth}{0.4pt}
  \fancyhead[L]{\sffamily\small
    \ifx\rel@cabecalho\@empty\rel@titulo\else\rel@cabecalho\fi}
  \fancyfoot[L]{\sffamily\small\rel@escola}
  \fancyfoot[R]{\sffamily\small\thepage}
}

% =============================================================================
%  NUMERAÇÃO DE PÁGINAS
%  Pré-textual (capa, folha de rosto, resumo, sumário, listas): sem número,
%  para qualquer quantidade de páginas.
%  Textual: numeração arábica reiniciada em 1, com cabeçalho e rodapé.
% =============================================================================
\newcommand{\iniciarPreTextual}{%
  \pagestyle{empty}%
  \pagenumbering{gobble}%
}
\newcommand{\iniciarTextual}{%
  \clearpage
  \pagestyle{relatorio}%
  \pagenumbering{arabic}%
  \setcounter{page}{1}%
}

% =============================================================================
%  ELEMENTOS PRÉ-TEXTUAIS
% =============================================================================
\newcommand{\fazcapa}{%
  \begin{titlepage}
    \begin{center}
      {\bfseries\large\rel@instituicao}\\[3pt]
      {\large\rel@escola}\\[3pt]
      {\large\rel@curso}
      \vspace{5cm}

      {\bfseries\LARGE\rel@titulo}
      \vspace{\fill}

      \rel@autoreslinhas
      \vspace{1.5cm}

      \rel@disciplina
      \vspace{\fill}

      \rel@local\\
      \rel@data
    \end{center}
  \end{titlepage}%
}

\newcommand{\fazfolhaderosto}{%
  \begin{titlepage}
    \begin{center}
      {\bfseries\large\rel@instituicao}\\[3pt]
      {\large\rel@escola}\\[3pt]
      {\large\rel@curso}
      \vspace{5cm}

      {\bfseries\LARGE\rel@titulo}
    \end{center}
    \vspace{2.5cm}

    \begin{flushright}
      \begin{minipage}{0.55\textwidth}
        \setstretch{1.15}\small
        \rel@descricao
        \vspace{12pt}

        \textbf{Aluno(s):} \rel@autoresinline\par
        \ifx\rel@disciplina\@empty\else\textbf{Disciplina:} \rel@disciplina\par\fi
        \ifx\rel@professor\@empty\else\textbf{Professor(a):} \rel@professor\par\fi
      \end{minipage}
    \end{flushright}
    \vspace{\fill}

    \begin{center}
      \rel@local\\
      \rel@data
    \end{center}
  \end{titlepage}%
}

% Resumo opcional:  \begin{resumo} texto \end{resumo}
\newenvironment{resumo}[1][Resumo]{%
  \clearpage
  \begin{center}\bfseries\large #1\end{center}
  \par\medskip
}{%
  \clearpage
}
\newcommand{\palavraschave}[1]{\par\medskip\noindent\textbf{Palavras-chave:} #1}

\newcommand{\sumario}{\clearpage\tableofcontents\clearpage}
\newcommand{\listafiguras}{%
  \clearpage\listoffigures
  \addcontentsline{toc}{section}{Lista de Figuras}\clearpage}
\newcommand{\listatabelas}{%
  \clearpage\listoftables
  \addcontentsline{toc}{section}{Lista de Tabelas}\clearpage}

% =============================================================================
%  SEÇÕES DE EXPERIMENTO/PRÁTICA NUMERADAS AUTOMATICAMENTE (opcional)
%  Uso:         \experimento[exp:queda-livre]{Queda Livre}
%  Referência:  \ref{exp:queda-livre}  ->  02
%  Evita que o número escrito no texto se desencontre do número da seção.
%  \rotuloExperimento troca a palavra: "Prática", "Atividade", "Questão"...
% =============================================================================
\newcounter{experimento}
\renewcommand{\theexperimento}{\two@digits{\value{experimento}}}
\def\rel@rotuloexp{Experimento}
\newcommand{\rotuloExperimento}[1]{\gdef\rel@rotuloexp{#1}}
\newcommand{\experimento}[2][]{%
  \refstepcounter{experimento}%
  \def\@tempa{#1}%
  \ifx\@tempa\@empty\else\label{#1}\fi
  \section{\rel@rotuloexp~\theexperimento{} --- #2}%
}

% =============================================================================
%  APÊNDICES:  \iniciarApendices  e depois \section{Título}
% =============================================================================
\newcommand{\iniciarApendices}{%
  \clearpage
  \appendix
  \setcounter{section}{0}%
  \renewcommand{\thesection}{Apêndice \Alph{section}}%
}

% =============================================================================
%  MOLDURA PARA FIGURA AINDA NÃO INSERIDA
%  Uso:  \figplaceholder{Descrição do que entra aqui}
% =============================================================================
\newcommand{\figplaceholder}[1]{%
  \begin{mdframed}[
    backgroundcolor=placeholderbg,
    linecolor=placeholderframe,
    linewidth=1.2pt,
    innertopmargin=14pt,
    innerbottommargin=14pt,
    roundcorner=4pt
  ]
  \centering
  {\color{placeholderframe}\large\textbf{[ Figura pendente ]}}\\[6pt]
  {\color{gray}\itshape #1}
  \end{mdframed}%
}

\endinput
